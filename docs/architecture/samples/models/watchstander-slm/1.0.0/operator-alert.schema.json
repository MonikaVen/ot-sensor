{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OperatorAlert",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alert_title",
    "alert_body",
    "tactics",
    "techniques",
    "recommend",
    "fault_vs_attack"
  ],
  "properties": {
    "alert_title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "alert_body": {
      "type": "string",
      "minLength": 24,
      "maxLength": 1200
    },
    "tactics": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "techniques": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
      }
    },
    "recommend": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "maxLength": 200 }
    },
    "fault_vs_attack": {
      "type": "string",
      "enum": ["attack", "fault", "undetermined"]
    }
  }
}
